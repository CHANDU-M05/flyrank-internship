# Server
PORT=3000
NODE_ENV=development

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgres://widget:widget@localhost:5432/widgetplatform

# Geo enrichment — both free, no key required
GEO_PROVIDER_A_URL=http://ip-api.com/json
GEO_PROVIDER_B_URL=https://ipapi.co
# Set to "true" to force both providers to fail (proves the "no geo, still stored" path)
MOCK_GEO_ALL_DOWN=false
# Set to "true" to force only provider A to fail (proves the fallback-to-B path)
MOCK_GEO_A_DOWN=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=20

# Email/webhook side effect (console-logged by default — no real SMTP needed)
NOTIFY_SHOULD_FAIL=false

# Allowed origins for the public widget API (comma-separated). The test-site
# server prints its own origin on startup — add it here.
PUBLIC_ALLOWED_ORIGINS=http://localhost:5500
